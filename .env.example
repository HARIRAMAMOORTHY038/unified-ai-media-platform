# ===================================================
# Unified AI Media Platform - Environment Configuration
# ===================================================

# Database (SQLite by default for zero-setup local storage)
DATABASE_URL=sqlite:///./media_platform.db

# JWT Security
JWT_SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Speech Recognition (Faster-Whisper on CPU)
# Options: 'tiny' (fastest, lowest RAM) or 'base' (optimal balance)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Video & File Upload Constraints
MAX_FILE_SIZE_MB=250
